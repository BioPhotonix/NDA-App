# Copy these into your host's environment variables
# (Vercel: Project Settings -> Environment Variables,
#  Netlify: Site configuration -> Environment variables).
#
# Never commit real values — this file is a template only.

# --- Required ---------------------------------------------------------------

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where completed NDAs are delivered. Comma-separate for more than one.
NDA_TO_EMAIL=info@biophotonix.co.uk

# The From address. The domain must be verified in Resend, otherwise Resend
# will reject the send. A display name is optional but looks better in an inbox.
NDA_FROM_EMAIL=BioPhotonix NDA <nda@biophotonix.co.uk>

# --- Optional ---------------------------------------------------------------

# Only needed if the page is served from a different domain than the API.
# Leave unset for a normal single-domain deployment (same-origin only).
# NDA_ALLOWED_ORIGINS=https://nda.biophotonix.co.uk

# Set to false to stop emailing the signer their own copy of the NDA.
# NDA_COPY_SIGNER=false

# Shown in the email copy sent to the signer.
# NDA_COMPANY_NAME=BioPhotonix Ltd
